# Database Neon Postgres
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Accesso all'app
APP_PASSWORD=Vivarelli2026!
AUTH_SECRET=questa-deve-essere-una-stringa-molto-lunga-e-casuale
CRON_SECRET=altro-segreto-casuale

# Protezione dei Vercel Cron
CRON_SECRET=imposta-un-altro-segreto-casuale

# Incentivi.gov.it
INCENTIVI_PAGE_ROWS=200
INCENTIVI_MAX_PAGES=35
INCENTIVI_CONCURRENCY=4

# EU Funding & Tenders
EU_PAGE_SIZE=50
EU_MAX_PAGES=20
EU_CONCURRENCY=4
EU_INCLUDE_FORTHCOMING=true
EU_PROGRAMME_FILTER=

# CCIAA Maremma e Tirreno (lg.camcom.it) - nessuna API pubblica, scraping HTML
CAMCOM_LG_MAX_PAGES=10
CAMCOM_LG_FETCH_DETAILS=true
CAMCOM_LG_DELAY_MS=400

# Teamleader Focus - Fase 1: sync clienti in sola lettura (companies -> customers)
# Registra un'app su https://marketplace.focus.teamleader.eu/it/build
TEAMLEADER_CLIENT_ID=
TEAMLEADER_CLIENT_SECRET=
TEAMLEADER_REDIRECT_URI=https://vostro-dominio.vercel.app/api/integrations/teamleader/callback
TEAMLEADER_PAGE_SIZE=100
TEAMLEADER_MAX_PAGES=100

# ID dei custom field Teamleader da mappare sui campi cliente (opzionali).
# Si trovano in Teamleader > Impostazioni > Campi personalizzati (companies), copiando l'ID del campo.
TEAMLEADER_CF_REGIONE=
TEAMLEADER_CF_PROVINCIA=
TEAMLEADER_CF_ATECO=
TEAMLEADER_CF_DIMENSIONE=
TEAMLEADER_CF_DIPENDENTI=
TEAMLEADER_CF_FATTURATO=
TEAMLEADER_CF_INVESTIMENTO=

# Regione Lombardia E015 (opzionale: credenziali rilasciate dall'ecosistema E015)
LOMBARDIA_E015_URL=
LOMBARDIA_E015_TOKEN=
LOMBARDIA_E015_API_KEY=
LOMBARDIA_E015_API_KEY_HEADER=X-API-Key

# Bando Easy (opzionale)
BANDOEASY_API_KEY=
BANDOEASY_API_URL=https://api.bandoeasy.it/v1/grants
BANDOEASY_PAGE_SIZE=100
BANDOEASY_MAX_PAGES=20

# Matching
MATCH_MIN_SCORE=45
MATCH_INCLUDE_INELIGIBLE=false

# Networking delle fonti
SOURCE_HTTP_TIMEOUT_MS=20000
SOURCE_HTTP_RETRIES=2
