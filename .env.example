# Database Neon Postgres
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Accesso all'app
APP_PASSWORD=imposta-una-password-lunga-e-unica
AUTH_SECRET=imposta-un-segreto-casuale-di-almeno-32-byte

# Protezione dei Vercel Cron
CRON_SECRET=imposta-un-altro-segreto-casuale

# Limiti di sincronizzazione
INCENTIVI_PAGE_ROWS=200
INCENTIVI_MAX_PAGES=35
EU_PAGE_SIZE=50
EU_MAX_PAGES=20
EU_INCLUDE_FORTHCOMING=true
EU_PROGRAMME_FILTER=

# Matching: mostra solo match con score >= valore
MATCH_MIN_SCORE=50
